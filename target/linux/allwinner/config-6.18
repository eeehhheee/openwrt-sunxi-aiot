CONFIG_ARCH_SUNXI=y
CONFIG_AW_BSP=y
CONFIG_AW_KERNEL_ORIGIN=y
CONFIG_ARCH_SUN60I=y
CONFIG_ARCH_SUN60IW2=y
CONFIG_ARCH_SUN60IW2P1=y
CONFIG_AW_IC_BOARD=y
CONFIG_AW_CCU=y
CONFIG_AW_SUN60IW2_CCU=y
CONFIG_AW_SUN60IW2_R_CCU=y
CONFIG_AW_PINCTRL=y
CONFIG_AW_PINCTRL_SUN60IW2=y
CONFIG_AW_PINCTRL_SUN60IW2_R=y
CONFIG_AW_UART_NG=y
# CONFIG_AW_UART is not set
CONFIG_AW_UART_DYNAMIC_DEBUG=y
CONFIG_AW_SERIAL_CONSOLE=y
# The BSP ships its own sunxi-ng implementation under bsp/drivers/clk/sunxi-ng.
# The mainline copy defines the same ccu_* globals and only collides at vmlinux link time.
# CONFIG_SUNXI_CCU is not set
# The BSP supplies SD/eMMC on Sun60IW2. The mainline host driver cannot be
# used: it calls the mainline sunxi-ng symbols disabled above, and its
# of_match table does not know the "allwinner,sunxi-mmc-v4p6x" compatible
# the DTS uses. Without an MMC host the image cannot mount its rootfs.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
# CONFIG_MMC_SUNXI is not set
# AW_MMC needs MMC_HSQ || AW_MMC_HSQ and the generic fragment disables MMC_HSQ.
CONFIG_AW_MMC_HSQ=y
CONFIG_AW_MMC=y
CONFIG_AW_MMC_V4P00X=y
CONFIG_AW_MMC_V4P1X=y
CONFIG_AW_MMC_V4P5X=y
CONFIG_AW_MMC_V5P3X=y
